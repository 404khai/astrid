{
  "expo": {
    "name": "Astrid",
    "slug": "astrid-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.astrid.mobile",
      "icon": "./assets/app-icon.png"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Astrid uses the camera to scan the pairing code on your Mac.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "icon": "./assets/app-icon.png",
    "android": {
      "package": "dev.astrid.mobile",
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#0b0b10"
      },
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "astrid"
  }
}
